{
  "$schema": "./hooks/crew/crew.schema.json",
  "baseBranch": "main",
  "protectedBranches": ["main"],
  "specFirst": {
    "mode": "nudge",
    "ruleFile": ".claude/rules/tdd.md",
    "roots": [
      { "path": "src/js", "moduleDepth": 0, "testRoots": ["tests"] }
    ],
    "sourceExtensions": [".js"],
    "testPatterns": ["test_*.py"]
  }
}
